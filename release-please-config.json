{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": false,
  "versioning": "prerelease",
  "prerelease-type": "rc",
  "prerelease": true,
  "packages": {
    "cloudflare-pages-deploy": {
      "component": "cloudflare-pages-deploy",
      "changelog-path": "CHANGELOG.md",
      "versioning": "default",
      "prerelease": false
    },
    "cloudflare-workers-check": {
      "component": "cloudflare-workers-check",
      "changelog-path": "CHANGELOG.md",
      "versioning": "default",
      "prerelease": false
    },
    "cloudflare-workers-deploy": {
      "component": "cloudflare-workers-deploy",
      "changelog-path": "CHANGELOG.md",
      "versioning": "default",
      "prerelease": false
    },
    "moodle-plugin-check": {
      "component": "moodle-plugin-check",
      "changelog-path": "CHANGELOG.md",
      "versioning": "default",
      "prerelease": false
    },
    "moodle-plugin-package": {
      "component": "moodle-plugin-package",
      "changelog-path": "CHANGELOG.md",
      "versioning": "default",
      "prerelease": false
    },
    "release-please": {
      "component": "release-please",
      "changelog-path": "CHANGELOG.md",
      "versioning": "default",
      "prerelease": false
    }
  }
}
